model Property {
  id          String         @id @default(uuid()) @db.Uuid
  slug        String         @unique @db.VarChar(255)
  landlordId  String         @map("landlord_id") @db.Uuid
  categoryId  String         @map("category_id") @db.Uuid
  addressId   Int?           @unique @map("address_id")
  title       String         @db.VarChar(255)
  description String
  status      PropertyStatus @default(DRAFT)
  isFeatured  Boolean        @default(false) @map("is_featured")
  isVerified  Boolean        @default(false) @map("is_verified")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  landlord  User              @relation("LandlordProperties", fields: [landlordId], references: [id])
  category  Category          @relation(fields: [categoryId], references: [id])
  address   Address?          @relation(fields: [addressId], references: [id])
  units     PropertyUnit[]
  images    PropertyImage[]
  amenities PropertyAmenity[]
  reviews   Review[]
  verificationQueue PropertyVerificationQueue?

  @@index([landlordId])
  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@index([createdAt])
  @@map("properties")
}

model PropertyUnit {
  id          String             @id @default(uuid()) @db.Uuid
  propertyId  String             @map("property_id") @db.Uuid
  unitLabel   String             @map("unit_label") @db.VarChar(255)
  status      PropertyUnitStatus @default(AVAILABLE)
  sizeSqft    Int?               @map("size_sqft")
  bedrooms    Int                @default(0) @db.SmallInt
  bathrooms   Int                @default(0) @db.SmallInt
  floor       Int?               @db.SmallInt
  description String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  property       Property              @relation(fields: [propertyId], references: [id])
  pricing        Pricing[]
  rentalRequests RentalRequest[]
  leases         Lease[]
  images         PropertyImage[]
  amenities      PropertyUnitAmenity[]

  @@index([propertyId])
  @@index([status])
  @@map("property_units")
}

model PropertyVerificationQueue {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @unique @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("property_verification_queue")
}

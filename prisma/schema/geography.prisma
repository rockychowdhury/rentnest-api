model Division {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  districts District[]

  @@map("divisions")
}

model District {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  divisionId Int      @map("division_id")
  division   Division @relation(fields: [divisionId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  areas      Area[]

  @@index([divisionId])
  @@index([name])
  @@map("districts")
}

model Area {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  districtId Int      @map("division_id")
  district   District @relation(fields: [districtId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  addresses Address[]

  @@index([districtId])
  @@index([name])
  @@map("areas")
}

model Address {
  id            Int      @id @default(autoincrement())
  buildingNo    String   @map("building_no") @db.VarChar(255)
  streetAddress String   @map("street_address") @db.VarChar(255)
  addressLine2  String?  @map("address_line2")
  landmark      String?  @db.VarChar(255)
  postalCode    String   @map("postal_code") @db.VarChar(20)
  areaId        Int      @map("area_id")
  area          Area     @relation(fields: [areaId], references: [id])
  latitude      Decimal? @db.Decimal(11, 8)
  longitude     Decimal? @db.Decimal(11, 8)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  property Property?

  @@index([areaId])
  @@map("addresses")
}
